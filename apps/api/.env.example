# Server
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic_saas?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookies
COOKIE_SECRET=replace-with-another-random-secret

# Logging
LOG_LEVEL=info

# Payments (Razorpay-compatible — populate when payments module is implemented)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Object storage (Cloudinary/S3-compatible — populate when storage module is implemented)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
