// Foundational schema for Phase 0. Only entities needed to support authentication,
// RBAC, and basic clinic/doctor/patient identity are modeled here. Appointments,
// scheduling, live queue, billing, EMR, etc. are added in later phases as those
// modules are implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  GUEST
  PATIENT
  DOCTOR
  RECEPTIONIST
  CLINIC_STAFF
  CLINIC_ADMIN
  HOSPITAL_ADMIN
  LAB_PARTNER
  PHARMACY_PARTNER
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  EMAIL_VERIFICATION
  MOBILE_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LabReportStatus {
  PENDING
  READY
}

enum MedicalRecordType {
  CONSULTATION_NOTE
  DIAGNOSIS
  SURGERY
  HOSPITALIZATION
  OTHER
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum NotificationType {
  APPOINTMENT_UPDATE
  QUEUE_UPDATE
  PRESCRIPTION_READY
  REPORT_READY
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  BOTH
  NONE
}

/// Doctor's manually-set availability/session status for a clinic session on a given day.
/// Staff-controlled, never inferred. IN_CONSULTATION is set automatically by the consultation
/// module; NOT_ARRIVED/ARRIVED are reserved for a future reception check-in flow.
enum DoctorSessionStatus {
  NOT_ARRIVED
  ARRIVED
  AVAILABLE
  IN_CONSULTATION
  ON_BREAK
  DELAYED
  UNAVAILABLE
  SESSION_ENDED
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TokenStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  NO_SHOW
  CANCELLED
}

enum TokenType {
  SCHEDULED
  WALK_IN
  EMERGENCY
}

/// Queue-ordering urgency, distinct from TokenType (origin). Deterministic rank order:
/// EMERGENCY > URGENT > FOLLOW_UP > NORMAL — applied wherever the queue is ordered.
enum TokenPriority {
  NORMAL
  FOLLOW_UP
  URGENT
  EMERGENCY
}

/// Walk-in intake flag only — no payment processing. Payment Engine is explicitly out of scope.
enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

enum ConsultationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
}

enum FoodTiming {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  ANYTIME
}

enum LeaveType {
  LEAVE
  HOLIDAY
}

// ---------------------------------------------------------------------------
// Identity & Auth
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String?
  role                UserRole  @default(PATIENT)
  isEmailVerified     Boolean   @default(false)
  isMobileVerified    Boolean   @default(false)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions          Session[]
  auditLogs         AuditLog[]
  doctorProfile     Doctor?
  patientProfile    Patient?
  clinicStaff       ClinicStaffMember[]
  notifications     Notification[]
  notificationPrefs NotificationPreference?

  @@index([role])
  @@map("users")
}

/// A logical login instance (one per device/browser). Stable identity across refresh-token
/// rotations — the JWT `sessionId` claim points here, not at the underlying RefreshToken row.
model Session {
  id            String    @id @default(uuid())
  userId        String
  userAgent     String?
  ipAddress     String?
  deviceLabel   String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

/// The single currently-valid refresh token for a session. Rotated in place on each
/// /auth/refresh call; presenting a stale (already-rotated) hash revokes the whole session.
model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid())
  identifier  String
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([identifier, purpose])
  @@index([identifier, purpose, createdAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Clinics, Doctors, Patients
// ---------------------------------------------------------------------------

model Clinic {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  email        String?
  phone        String?
  description  String?
  photoUrl     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("IN")
  timezone     String  @default("Asia/Kolkata")
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  doctors        ClinicDoctor[]
  staff          ClinicStaffMember[]
  appointments   Appointment[]
  doctorSessions DoctorSession[]
  doctorLeaves   DoctorLeave[]
  auditLogs      AuditLog[]

  @@index([slug])
  @@index([city])
  @@map("clinics")
}

/// A hospital is a distinct facility type from a clinic (larger, multi-department, its own
/// admin role). No doctor-affiliation model yet — Phase 2 only needs a public directory listing.
model Hospital {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  email        String?
  phone        String?
  description  String?
  photoUrl     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("IN")
  bedCount     Int?
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([city])
  @@map("hospitals")
}

model Specialization {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  iconName    String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  doctors Doctor[]

  @@index([slug])
  @@map("specializations")
}

model Doctor {
  id                 String   @id @default(uuid())
  userId             String   @unique
  slug               String   @unique
  displayName        String
  specializationId   String?
  qualifications     String?
  bio                String?
  gender             Gender?
  languages          String[]
  yearsExperience    Int?
  consultationFee    Decimal? @db.Decimal(10, 2)
  profileImageUrl    String?
  onlineConsultation Boolean  @default(false)
  ratingAverage      Float?
  ratingCount        Int      @default(0)
  isActive           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization Specialization?  @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  clinics        ClinicDoctor[]
  reviews        DoctorReview[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  sessions       DoctorSession[]
  leaves         DoctorLeave[]
  signature      DoctorSignature?
  medicalRecords MedicalRecord[]
  consultations  Consultation[]

  @@index([slug])
  @@index([specializationId])
  @@index([gender])
  @@map("doctors")
}

/// Many-to-many: a doctor can practice at multiple clinics, with per-clinic timings.
model ClinicDoctor {
  id                                  String    @id @default(uuid())
  clinicId                            String
  doctorId                            String
  isActive                            Boolean   @default(true)
  timings                             String?
  availableDays                       Weekday[]
  consultationFeeOverride             Decimal?  @db.Decimal(10, 2)
  consultationDurationMinutesOverride Int?
  isAcceptingAppointments             Boolean   @default(true)
  /// Grants this doctor permission to override the receptionist's manual delay controls for
  /// this clinic (spec: doctor is read-only on delay by default, "unless authorized by clinic permissions").
  canOverrideDelay                    Boolean   @default(false)

  createdAt DateTime @default(now())

  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  availability DoctorAvailability[]

  @@unique([clinicId, doctorId])
  @@index([doctorId])
  @@map("clinic_doctors")
}

model DoctorReview {
  id          String    @id @default(uuid())
  doctorId    String
  authorName  String
  rating      Int
  comment     String
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_reviews")
}

/// Recurring weekly availability template for a doctor at a specific clinic. Multiple rows with
/// the same weekday support multiple sessions per day (e.g. morning + evening).
model DoctorAvailability {
  id                          String    @id @default(uuid())
  clinicDoctorId              String
  weekday                     Weekday
  startTime                   DateTime  @db.Time
  endTime                     DateTime  @db.Time
  consultationDurationMinutes Int
  breakStartTime              DateTime? @db.Time
  breakEndTime                DateTime? @db.Time
  isActive                    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicDoctor ClinicDoctor @relation(fields: [clinicDoctorId], references: [id], onDelete: Cascade)

  @@unique([clinicDoctorId, weekday, startTime])
  @@index([clinicDoctorId])
  @@map("doctor_availability")
}

/// A leave or holiday date range for a doctor. `clinicId = null` means unavailable at all clinics.
model DoctorLeave {
  id        String    @id @default(uuid())
  doctorId  String
  clinicId  String?
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  reason    String?
  type      LeaveType @default(LEAVE)

  createdAt DateTime @default(now())

  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDate, endDate])
  @@map("doctor_leaves")
}

/// One doctor's live status + queue container for a specific clinic on a specific day.
/// Per-(doctor, clinic, day) because a doctor can hold different statuses at different clinics
/// concurrently, and dashboards/audit need "today" distinguished from history.
model DoctorSession {
  id                         String              @id @default(uuid())
  doctorId                   String
  clinicId                   String
  sessionDate                DateTime            @db.Date
  status                     DoctorSessionStatus @default(NOT_ARRIVED)
  queueStatus                QueueStatus         @default(CLOSED)
  startedAt                  DateTime?
  endedAt                    DateTime?
  currentTokenId             String?
  averageConsultationMinutes Int?
  delayMinutes               Int?
  delayReason                String?
  delayUpdatedAt             DateTime?
  delayUpdatedBy             String?
  /// Reason shown to waiting patients while queueStatus = PAUSED (distinct from delayReason).
  pauseReason                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tokens QueueToken[]

  @@unique([doctorId, clinicId, sessionDate])
  @@index([clinicId, sessionDate])
  @@index([status])
  @@map("doctor_sessions")
}

/// A single patient's position in a doctor's live queue for a given session.
model QueueToken {
  id              String        @id @default(uuid())
  doctorSessionId String
  appointmentId   String?       @unique
  patientId       String
  tokenNumber     Int
  type            TokenType     @default(SCHEDULED)
  status          TokenStatus   @default(WAITING)
  priority        TokenPriority @default(NORMAL)
  calledAt        DateTime?
  calledCount     Int           @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  skipReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorSession DoctorSession @relation(fields: [doctorSessionId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation  Consultation?

  @@unique([doctorSessionId, tokenNumber])
  @@index([doctorSessionId, status])
  @@index([patientId])
  @@map("queue_tokens")
}

/// The durable clinical record for one appointment. 1:1 with Appointment.
model Consultation {
  id                     String             @id @default(uuid())
  appointmentId          String             @unique
  doctorId               String
  patientId              String
  clinicId               String
  tokenId                String?            @unique
  status                 ConsultationStatus @default(NOT_STARTED)
  chiefComplaint         String?
  symptoms               String[]
  heightCm               Float?
  weightKg               Float?
  temperatureC           Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulseRate              Int?
  respiratoryRate        Int?
  spo2                   Int?
  diagnosis              String?
  doctorNotes            String?
  treatmentPlan          String?
  followUpDate           DateTime?
  startedAt              DateTime?
  completedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  token         QueueToken?    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([doctorId, status])
  @@index([patientId])
  @@map("consultations")
}

/// A single medicine line item on a prescription.
model PrescriptionItem {
  id              String      @id @default(uuid())
  prescriptionId  String
  sortOrder       Int
  medicineName    String
  dosage          String
  frequency       String
  duration        String
  route           String?
  instructions    String?
  beforeAfterFood FoodTiming?
  quantity        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// Reusable signature asset stamped onto a doctor's finalized prescriptions.
/// Architecture only — no PKI/certificate-based e-signing.
model DoctorSignature {
  id                String  @id @default(uuid())
  doctorId          String  @unique
  signatureImageUrl String?
  signatureText     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_signatures")
}

model Testimonial {
  id           String  @id @default(uuid())
  authorName   String
  authorDetail String?
  message      String
  rating       Int?
  avatarUrl    String?
  isFeatured   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([isFeatured])
  @@map("testimonials")
}

model Article {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  excerpt       String
  coverImageUrl String?
  category      String?
  authorName    String?
  publishedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([slug])
  @@index([publishedAt])
  @@map("articles")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Patient {
  id                String    @id @default(uuid())
  userId            String    @unique
  fullName          String
  profileImageUrl   String?
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  allergies         String[]
  medicalConditions String[]
  addressLine1      String?
  city              String?
  state             String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses      PatientAddress[]
  appointments   Appointment[]
  prescriptions  Prescription[]
  labReports     LabReport[]
  vaccinations   Vaccination[]
  vitalRecords   VitalRecord[]
  medicalRecords MedicalRecord[]
  queueTokens    QueueToken[]
  consultations  Consultation[]

  @@map("patients")
}

model PatientAddress {
  id           String       @id @default(uuid())
  patientId    String
  label        AddressLabel @default(HOME)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String       @default("IN")
  isDefault    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_addresses")
}

// ---------------------------------------------------------------------------
// Patient Portal: appointments, records, notifications
// ---------------------------------------------------------------------------

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  clinicId        String
  scheduledAt     DateTime
  status          AppointmentStatus @default(CONFIRMED)
  tokenNumber     String?
  reasonForVisit  String?
  consultationFee Decimal?          @db.Decimal(10, 2)
  /// Walk-in intake flag only, set by reception at registration — no payment processing.
  paymentStatus   PaymentStatus?
  cancelReason    String?
  cancelledAt     DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  labReports    LabReport[]
  queueToken    QueueToken?
  consultation  Consultation?

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([status])
  @@map("appointments")
}

model Prescription {
  id                    String             @id @default(uuid())
  patientId             String
  doctorId              String
  appointmentId         String?
  consultationId        String?
  issuedAt              DateTime           @default(now())
  /// @deprecated superseded by the structured `items` relation; kept for legacy rows only.
  medications           Json
  status                PrescriptionStatus @default(DRAFT)
  diagnosis             String?
  advice                String?
  followUpDate          DateTime?
  labTestRecommendation String[]
  notes                 String?
  fileUrl               String?
  signedAt              DateTime?
  signatureImageUrl     String?
  signatureHash         String?
  pdfUrl                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment  Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  @@index([patientId, issuedAt])
  @@index([consultationId])
  @@index([status])
  @@map("prescriptions")
}

model LabReport {
  id            String          @id @default(uuid())
  patientId     String
  appointmentId String?
  testName      String
  labName       String?
  status        LabReportStatus @default(PENDING)
  reportDate    DateTime?
  fileUrl       String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@map("lab_reports")
}

model Vaccination {
  id               String    @id @default(uuid())
  patientId        String
  vaccineName      String
  doseNumber       Int?
  administeredDate DateTime
  nextDueDate      DateTime?
  administeredBy   String?
  notes            String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("vaccinations")
}

model VitalRecord {
  id                     String   @id @default(uuid())
  patientId              String
  recordedAt             DateTime @default(now())
  heightCm               Float?
  weightKg               Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRateBpm           Int?
  temperatureCelsius     Float?
  bloodSugarMgDl         Int?
  notes                  String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
  @@map("vital_records")
}

model MedicalRecord {
  id            String            @id @default(uuid())
  patientId     String
  /// Nullable: legacy/manually-entered records may only have a free-text doctorName. Records
  /// authored through the Doctor Portal's consultation workflow set both this FK and doctorName.
  doctorId      String?
  recordType    MedicalRecordType
  title         String
  description   String?
  recordDate    DateTime
  doctorName    String?
  attachmentUrl String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId, recordDate])
  @@index([doctorId])
  @@map("medical_records")
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  relatedEntityType String?
  relatedEntityId   String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String              @id @default(uuid())
  userId             String              @unique
  appointmentUpdates Boolean             @default(true)
  queueUpdates       Boolean             @default(true)
  prescriptionReady  Boolean             @default(true)
  reportReady        Boolean             @default(true)
  channel            NotificationChannel @default(EMAIL)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Receptionists / clinic staff / clinic admins scoped to a specific clinic.
model ClinicStaffMember {
  id          String   @id @default(uuid())
  userId      String
  clinicId    String
  title       String?
  isActive    Boolean  @default(true)
  /// Canonical keys defined once in packages/shared/src/permissions.ts (e.g. "queue.manage",
  /// "patient.checkin"). CLINIC_ADMIN role bypasses this list entirely — see reception.shared.ts.
  permissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_staff_members")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  /// Denormalized for direct "clinic queue history" queries without joining through entityId.
  /// Nullable — most audit rows (auth, profile edits) aren't clinic-scoped.
  clinicId    String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([clinicId, createdAt])
  @@map("audit_logs")
}
