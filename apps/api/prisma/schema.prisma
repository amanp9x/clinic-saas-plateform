// Foundational schema for Phase 0. Only entities needed to support authentication,
// RBAC, and basic clinic/doctor/patient identity are modeled here. Appointments,
// scheduling, live queue, billing, EMR, etc. are added in later phases as those
// modules are implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  GUEST
  PATIENT
  DOCTOR
  RECEPTIONIST
  CLINIC_STAFF
  CLINIC_ADMIN
  HOSPITAL_ADMIN
  LAB_PARTNER
  PHARMACY_PARTNER
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum OtpPurpose {
  LOGIN
  REGISTRATION
  EMAIL_VERIFICATION
  MOBILE_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  PATIENT
  RECEPTION
  DOCTOR
}

/// "First visit vs repeat visit" — deliberately separate from ConsultationType, which already
/// means modality (IN_CLINIC/ONLINE) and carries legacy FOLLOW_UP/EMERGENCY values used by the
/// ClinicDoctor.consultationTypes catalog-search filter. Reusing ConsultationType here would
/// corrupt that already-shipped filter semantics.
enum AppointmentType {
  NEW_CONSULTATION
  FOLLOW_UP
}

/// SlotHold lifecycle only — deliberately 3 states, not the "6 slot states" product concept
/// (AVAILABLE/HELD/BOOKED/BLOCKED/EXPIRED/CANCELLED), which is a read-time display computation
/// derived from Appointment + SlotHold + BlockedSlot together, not a persisted state machine.
enum SlotHoldStatus {
  ACTIVE
  EXPIRED
  RELEASED
}

enum LabReportStatus {
  PENDING
  READY
}

enum MedicalRecordType {
  CONSULTATION_NOTE
  DIAGNOSIS
  SURGERY
  HOSPITALIZATION
  OTHER
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

/// Legacy generic types (APPOINTMENT_UPDATE/QUEUE_UPDATE/SYSTEM) predate Phase 10's granular
/// event-typed notifications and are kept only for backward compatibility with already-persisted
/// rows — new dispatch call sites use the specific type below instead of these.
enum NotificationType {
  APPOINTMENT_UPDATE
  QUEUE_UPDATE
  PRESCRIPTION_READY
  REPORT_READY
  SYSTEM

  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_CHECKED_IN
  APPOINTMENT_NO_SHOW
  APPOINTMENT_REMINDER
  APPOINTMENT_STARTING_SOON

  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  PAYMENT_REFUND_PENDING

  QUEUE_CHECKED_IN
  PATIENT_CALLED
  PATIENT_SKIPPED
  QUEUE_DELAY_UPDATED
  DOCTOR_DELAYED
  DOCTOR_ON_TIME
  QUEUE_PAUSED
  QUEUE_RESUMED

  CONSULTATION_STARTED
  CONSULTATION_COMPLETED

  DOCTOR_STATUS_CHANGED

  CLINIC_ANNOUNCEMENT

  REVIEW_RECEIVED
  REVIEW_RESPONSE
  REVIEW_HIDDEN

  WAITLIST_SLOT_AVAILABLE

  SECURITY_LOGIN
  SECURITY_PASSWORD_CHANGED
}

/// Review moderation lifecycle (Phase 12). New reviews default to PUBLISHED (auto-publish, per
/// product decision — most review platforms publish immediately and moderate reactively rather
/// than gate every submission). PENDING exists for a moderator to explicitly flag a review for
/// further review without fully hiding/rejecting it; it is never the default entry state.
enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

/// Governs whether a notification's delivery can be suppressed by user preference.
/// TRANSACTIONAL/SECURITY always deliver in-app + email regardless of NotificationPreference.
enum NotificationTier {
  TRANSACTIONAL
  SECURITY
  OPTIONAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// Doctor's manually-set availability/session status for a clinic session on a given day.
/// Staff-controlled, never inferred. IN_CONSULTATION is set automatically by the consultation
/// module; NOT_ARRIVED/ARRIVED are reserved for a future reception check-in flow.
enum DoctorSessionStatus {
  NOT_ARRIVED
  ARRIVED
  AVAILABLE
  IN_CONSULTATION
  ON_BREAK
  DELAYED
  UNAVAILABLE
  SESSION_ENDED
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TokenStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  NO_SHOW
  CANCELLED
}

enum TokenType {
  SCHEDULED
  WALK_IN
  EMERGENCY
}

/// Queue-ordering urgency, distinct from TokenType (origin). Deterministic rank order:
/// EMERGENCY > URGENT > FOLLOW_UP > NORMAL — applied wherever the queue is ordered.
enum TokenPriority {
  NORMAL
  FOLLOW_UP
  URGENT
  EMERGENCY
}

/// Walk-in intake flag only, set by reception at registration — a simple 3-state "did the desk
/// collect payment" toggle. Left completely untouched by the Phase 9 Payment Engine below: it is
/// not a rich provider-integrated transaction lifecycle (no AUTHORIZED/CAPTURED/REFUND states),
/// so it is not "equivalent" and is not reused/renamed for that purpose.
enum PaymentStatus {
  PENDING
  PAID
  WAIVED
}

// ---------------------------------------------------------------------------
// Payments & Billing Engine (Phase 9)
// ---------------------------------------------------------------------------

enum PaymentProvider {
  MOCK
  RAZORPAY
  STRIPE
}

/// Payment (order-level) transaction lifecycle — the source of truth for whether an appointment
/// is paid. See PAYMENT_STATE_MACHINE in payment-state-machine.ts for the enforced transition graph.
enum PaymentTransactionStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

/// One row per provider order/checkout attempt — a Payment can have several across retries.
enum PaymentAttemptStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  OTHER
}

enum RefundStatus {
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

// ---------------------------------------------------------------------------
// Clinic Management (Phase 6)
// ---------------------------------------------------------------------------

enum ClinicOperatingStatus {
  OPEN
  CLOSED
  TEMPORARILY_CLOSED
  SUSPENDED
}

/// Clinic-side verification state only — no Super Admin review workflow yet (Phase 6 scope).
enum ClinicVerificationStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ClinicDocumentType {
  REGISTRATION_CERTIFICATE
  LICENSE
  TAX_DOCUMENT
  OTHER
}

enum ClinicDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

/// Tri-state doctor-clinic association status, distinct from `ClinicDoctor.isActive` (kept for
/// backward compatibility with every existing `isActive` consumer — kept in sync by the service
/// layer: isActive = (status === ACTIVE)).
enum ClinicDoctorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Configuration-only — no telemedicine implementation. Each ClinicDoctor association enables a
/// subset of these.
enum ConsultationType {
  IN_CLINIC
  ONLINE
  FOLLOW_UP
  EMERGENCY
}

enum ClinicResourceType {
  CONSULTATION_ROOM
  PROCEDURE_ROOM
  OTHER
}

enum ClinicResourceStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Governs how much patient detail (allergies, medical conditions) clinic staff's patient
/// quick-view surfaces — consumed by the existing Reception quick-view, not a new screen.
enum PatientDataVisibility {
  LIMITED
  FULL
}

enum ConsultationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
}

enum FoodTiming {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  ANYTIME
}

enum LeaveType {
  LEAVE
  HOLIDAY
}

// ---------------------------------------------------------------------------
// Identity & Auth
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String?
  role                UserRole  @default(PATIENT)
  isEmailVerified     Boolean   @default(false)
  isMobileVerified    Boolean   @default(false)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions             Session[]
  auditLogs            AuditLog[]
  doctorProfile        Doctor?
  patientProfile       Patient?
  clinicStaff          ClinicStaffMember[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference?
  uploadedDocuments    ClinicDocument[]
  sentStaffInvitations StaffInvitation[]

  @@index([role])
  @@map("users")
}

/// A logical login instance (one per device/browser). Stable identity across refresh-token
/// rotations — the JWT `sessionId` claim points here, not at the underlying RefreshToken row.
model Session {
  id            String    @id @default(uuid())
  userId        String
  userAgent     String?
  ipAddress     String?
  deviceLabel   String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

/// The single currently-valid refresh token for a session. Rotated in place on each
/// /auth/refresh call; presenting a stale (already-rotated) hash revokes the whole session.
model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid())
  identifier  String
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  @@index([identifier, purpose])
  @@index([identifier, purpose, createdAt])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Clinics, Doctors, Patients
// ---------------------------------------------------------------------------

model Clinic {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  email        String?
  phone        String?
  description  String?
  photoUrl     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  area         String?
  state        String?
  postalCode   String?
  country      String  @default("IN")
  timezone     String  @default("Asia/Kolkata")
  isActive     Boolean @default(true)

  /// Denormalized aggregate over PUBLISHED ClinicReview rows only — recomputed via DB aggregation
  /// (COUNT/AVG) whenever a review's status changes to/from PUBLISHED, never incremented ad hoc.
  /// Phase 7 deliberately did not add this (no ClinicReview existed yet, and clinic `minRating`
  /// filtering meant "has a doctor rated >= X" instead) — that justification no longer applies now
  /// that real clinic reviews exist, so these mirror Doctor.ratingAverage/ratingCount exactly.
  ratingAverage Float?
  ratingCount   Int    @default(0)

  /// Profile — legal/registration
  legalName          String?
  clinicType         String?
  registrationNumber String?
  establishedYear    Int?
  languages          String[]
  facilities         String[]
  accessibilityInfo  String?
  coverImageUrl      String?

  /// Profile — contact/social
  alternatePhone String?
  website        String?
  instagramUrl   String?
  facebookUrl    String?
  latitude       Float?
  longitude      Float?

  /// Operating status — Clinic Admin can temporarily close with a reason. Distinct from
  /// `isActive` (platform-level enable/disable) — this is the clinic's own operating state.
  status          ClinicOperatingStatus @default(OPEN)
  statusReason    String?
  statusUpdatedAt DateTime?

  /// Verification — clinic-side state only, no Super Admin review workflow in this phase.
  verificationStatus      ClinicVerificationStatus @default(PENDING)
  verificationSubmittedAt DateTime?
  verificationNotes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  doctors          ClinicDoctor[]
  staff            ClinicStaffMember[]
  appointments     Appointment[]
  doctorSessions   DoctorSession[]
  doctorLeaves     DoctorLeave[]
  auditLogs        AuditLog[]
  documents        ClinicDocument[]
  departments      Department[]
  services         ClinicService[]
  workingHours     ClinicWorkingHours[]
  holidays         ClinicHoliday[]
  resources        ClinicResource[]
  staffInvitations StaffInvitation[]
  settings         ClinicSettings?
  reviews          ClinicReview[]
  favorites        Favorite[]
  slotHolds        SlotHold[]
  blockedSlots     BlockedSlot[]
  payments         Payment[]
  invoices         Invoice[]
  waitlistEntries  WaitlistEntry[]

  @@index([slug])
  @@index([city])
  @@index([city, area])
  @@map("clinics")
}

/// A hospital is a distinct facility type from a clinic (larger, multi-department, its own
/// admin role). No doctor-affiliation model yet — Phase 2 only needs a public directory listing.
model Hospital {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique
  email        String?
  phone        String?
  description  String?
  photoUrl     String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  area         String?
  state        String?
  postalCode   String?
  country      String  @default("IN")
  bedCount     Int?
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([city])
  @@index([city, area])
  @@map("hospitals")
}

model Specialization {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  iconName    String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  doctors Doctor[]

  @@index([slug])
  @@map("specializations")
}

model Doctor {
  id                 String   @id @default(uuid())
  userId             String   @unique
  slug               String   @unique
  displayName        String
  specializationId   String?
  qualifications     String?
  bio                String?
  gender             Gender?
  languages          String[]
  yearsExperience    Int?
  consultationFee    Decimal? @db.Decimal(10, 2)
  profileImageUrl    String?
  onlineConsultation Boolean  @default(false)
  ratingAverage      Float?
  ratingCount        Int      @default(0)
  isActive           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization  Specialization?  @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  clinics         ClinicDoctor[]
  reviews         DoctorReview[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  sessions        DoctorSession[]
  leaves          DoctorLeave[]
  signature       DoctorSignature?
  medicalRecords  MedicalRecord[]
  consultations   Consultation[]
  favorites       Favorite[]
  slotHolds       SlotHold[]
  blockedSlots    BlockedSlot[]
  payments        Payment[]
  invoices        Invoice[]
  waitlistEntries WaitlistEntry[]

  @@index([slug])
  @@index([specializationId])
  @@index([gender])
  @@map("doctors")
}

/// Many-to-many: a doctor can practice at multiple clinics, with per-clinic timings.
model ClinicDoctor {
  id                                  String    @id @default(uuid())
  clinicId                            String
  doctorId                            String
  departmentId                        String?
  isActive                            Boolean   @default(true)
  timings                             String?
  availableDays                       Weekday[]
  consultationFeeOverride             Decimal?  @db.Decimal(10, 2)
  consultationDurationMinutesOverride Int?
  isAcceptingAppointments             Boolean   @default(true)
  /// Grants this doctor permission to override the receptionist's manual delay controls for
  /// this clinic (spec: doctor is read-only on delay by default, "unless authorized by clinic permissions").
  canOverrideDelay                    Boolean   @default(false)

  /// Tri-state status set by Clinic Admin — kept in sync with `isActive` by the service layer
  /// (isActive = status === ACTIVE) so every existing `isActive` consumer keeps working unchanged.
  status            ClinicDoctorStatus @default(ACTIVE)
  consultationTypes ConsultationType[] @default([IN_CLINIC])
  startDate         DateTime?          @db.Date
  endDate           DateTime?          @db.Date
  /// Per-clinic kill switch for this doctor's queue participation, independent of `isActive`.
  queueEnabled      Boolean            @default(true)

  createdAt DateTime @default(now())

  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor       Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  availability DoctorAvailability[]

  @@unique([clinicId, doctorId])
  @@index([doctorId])
  @@index([departmentId])
  @@map("clinic_doctors")
}

/// Phase 2 seeded this with only doctorId/authorName/rating/comment — Phase 12 extends it in place
/// (per the "reuse the exact source of truth" instruction) rather than building a parallel review
/// system. `patientId`/`appointmentId` are nullable so the original seeded testimonial-style rows
/// (no real patient/appointment behind them) keep working unchanged; every new Phase 12 submission
/// always sets both. `appointmentId @unique` is what makes "one review per appointment" a DB-level
/// guarantee, not just an application check.
model DoctorReview {
  id            String  @id @default(uuid())
  doctorId      String
  patientId     String?
  appointmentId String? @unique
  /// Snapshot of the reviewer's display name at submission time — same convention as
  /// Appointment's fee/duration snapshots, and what already made this field privacy-safe to
  /// expose publicly (never a live join to Patient/User).
  authorName    String
  rating        Int
  comment       String?

  /// Dimension ratings (1-5), all optional so the model stays extensible without forcing every
  /// historical/legacy row to have them.
  consultationExperience Int?
  communication          Int?
  professionalism        Int?
  explanationClarity     Int?

  status            ReviewStatus @default(PUBLISHED)
  moderatedByUserId String?
  moderatedAt       DateTime?
  moderationReason  String?

  response          String?
  respondedAt       DateTime?
  respondedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([doctorId, status])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("doctor_reviews")
}

/// Mirrors DoctorReview's shape with clinic-specific dimensions — kept as its own model rather
/// than a polymorphic "doctorId-or-clinicId" row because the dimension sets genuinely differ
/// (consultation/communication vs. staff/cleanliness/waiting) and there is no legacy clinic-review
/// seed data requiring nullable patient/appointment fields the way DoctorReview has.
model ClinicReview {
  id            String @id @default(uuid())
  clinicId      String
  patientId     String
  appointmentId String @unique
  authorName    String
  rating        Int

  staffExperience   Int?
  cleanliness       Int?
  waitingExperience Int?
  overallExperience Int?

  comment String?

  status            ReviewStatus @default(PUBLISHED)
  moderatedByUserId String?
  moderatedAt       DateTime?
  moderationReason  String?

  response          String?
  respondedAt       DateTime?
  respondedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
  @@map("clinic_reviews")
}

/// A patient's saved doctor or clinic (discovery/favorites). Exactly one of doctorId/clinicId is
/// set per row — enforced in the service layer, not the DB (no raw SQL check constraints elsewhere
/// in this schema). Postgres unique constraints ignore NULLs, so a doctor-row and a clinic-row
/// never collide with each other on these two unique indexes.
model Favorite {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String?
  clinicId  String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic  Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@unique([patientId, clinicId])
  @@index([patientId])
  @@map("favorites")
}

/// Recurring weekly availability template for a doctor at a specific clinic. Multiple rows with
/// the same weekday support multiple sessions per day (e.g. morning + evening).
model DoctorAvailability {
  id                          String    @id @default(uuid())
  clinicDoctorId              String
  weekday                     Weekday
  startTime                   DateTime  @db.Time
  endTime                     DateTime  @db.Time
  consultationDurationMinutes Int
  breakStartTime              DateTime? @db.Time
  breakEndTime                DateTime? @db.Time
  isActive                    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicDoctor ClinicDoctor @relation(fields: [clinicDoctorId], references: [id], onDelete: Cascade)

  @@unique([clinicDoctorId, weekday, startTime])
  @@index([clinicDoctorId])
  @@map("doctor_availability")
}

/// A leave or holiday date range for a doctor. `clinicId = null` means unavailable at all clinics.
model DoctorLeave {
  id        String    @id @default(uuid())
  doctorId  String
  clinicId  String?
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  reason    String?
  type      LeaveType @default(LEAVE)

  createdAt DateTime @default(now())

  doctor Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([doctorId, startDate, endDate])
  @@map("doctor_leaves")
}

/// One doctor's live status + queue container for a specific clinic on a specific day.
/// Per-(doctor, clinic, day) because a doctor can hold different statuses at different clinics
/// concurrently, and dashboards/audit need "today" distinguished from history.
model DoctorSession {
  id                         String              @id @default(uuid())
  doctorId                   String
  clinicId                   String
  sessionDate                DateTime            @db.Date
  status                     DoctorSessionStatus @default(NOT_ARRIVED)
  queueStatus                QueueStatus         @default(CLOSED)
  startedAt                  DateTime?
  endedAt                    DateTime?
  currentTokenId             String?
  averageConsultationMinutes Int?
  delayMinutes               Int?
  delayReason                String?
  delayUpdatedAt             DateTime?
  delayUpdatedBy             String?
  /// Reason shown to waiting patients while queueStatus = PAUSED (distinct from delayReason).
  pauseReason                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  tokens QueueToken[]

  @@unique([doctorId, clinicId, sessionDate])
  @@index([clinicId, sessionDate])
  @@index([status])
  @@map("doctor_sessions")
}

/// A single patient's position in a doctor's live queue for a given session.
model QueueToken {
  id              String        @id @default(uuid())
  doctorSessionId String
  appointmentId   String?       @unique
  patientId       String
  tokenNumber     Int
  type            TokenType     @default(SCHEDULED)
  status          TokenStatus   @default(WAITING)
  priority        TokenPriority @default(NORMAL)
  calledAt        DateTime?
  calledCount     Int           @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  skipReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorSession DoctorSession @relation(fields: [doctorSessionId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation  Consultation?

  @@unique([doctorSessionId, tokenNumber])
  @@index([doctorSessionId, status])
  @@index([patientId])
  @@map("queue_tokens")
}

/// The durable clinical record for one appointment. 1:1 with Appointment.
model Consultation {
  id                     String             @id @default(uuid())
  appointmentId          String             @unique
  doctorId               String
  patientId              String
  clinicId               String
  tokenId                String?            @unique
  status                 ConsultationStatus @default(NOT_STARTED)
  chiefComplaint         String?
  symptoms               String[]
  heightCm               Float?
  weightKg               Float?
  temperatureC           Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  pulseRate              Int?
  respiratoryRate        Int?
  spo2                   Int?
  diagnosis              String?
  doctorNotes            String?
  treatmentPlan          String?
  followUpDate           DateTime?
  startedAt              DateTime?
  completedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  token         QueueToken?    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([doctorId, status])
  @@index([patientId])
  @@map("consultations")
}

/// A single medicine line item on a prescription.
model PrescriptionItem {
  id              String      @id @default(uuid())
  prescriptionId  String
  sortOrder       Int
  medicineName    String
  dosage          String
  frequency       String
  duration        String
  route           String?
  instructions    String?
  beforeAfterFood FoodTiming?
  quantity        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

/// Reusable signature asset stamped onto a doctor's finalized prescriptions.
/// Architecture only — no PKI/certificate-based e-signing.
model DoctorSignature {
  id                String  @id @default(uuid())
  doctorId          String  @unique
  signatureImageUrl String?
  signatureText     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_signatures")
}

model Testimonial {
  id           String  @id @default(uuid())
  authorName   String
  authorDetail String?
  message      String
  rating       Int?
  avatarUrl    String?
  isFeatured   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([isFeatured])
  @@map("testimonials")
}

model Article {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  excerpt       String
  coverImageUrl String?
  category      String?
  authorName    String?
  publishedAt   DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([slug])
  @@index([publishedAt])
  @@map("articles")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Patient {
  id                String    @id @default(uuid())
  userId            String    @unique
  fullName          String
  profileImageUrl   String?
  dateOfBirth       DateTime?
  gender            Gender?
  bloodGroup        String?
  allergies         String[]
  medicalConditions String[]
  addressLine1      String?
  city              String?
  state             String?
  postalCode        String?
  emergencyName     String?
  emergencyPhone    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses       PatientAddress[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  labReports      LabReport[]
  vaccinations    Vaccination[]
  vitalRecords    VitalRecord[]
  medicalRecords  MedicalRecord[]
  queueTokens     QueueToken[]
  consultations   Consultation[]
  favorites       Favorite[]
  slotHolds       SlotHold[]
  payments        Payment[]
  invoices        Invoice[]
  doctorReviews   DoctorReview[]
  clinicReviews   ClinicReview[]
  waitlistEntries WaitlistEntry[]

  @@map("patients")
}

model PatientAddress {
  id           String       @id @default(uuid())
  patientId    String
  label        AddressLabel @default(HOME)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String       @default("IN")
  isDefault    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_addresses")
}

// ---------------------------------------------------------------------------
// Patient Portal: appointments, records, notifications
// ---------------------------------------------------------------------------

/// Booking-engine fields (Phase 8) are additive to the pre-existing walk-in/queue fields above.
/// IMPORTANT: double-booking is NOT prevented by any constraint expressible here — Postgres
/// partial unique indexes aren't representable in the Prisma schema DSL. The actual guarantee is
/// a hand-added migration statement:
///   CREATE UNIQUE INDEX "appointments_doctor_clinic_scheduled_active_key" ON "appointments"
///     ("doctorId", "clinicId", "scheduledAt") WHERE "status" NOT IN ('CANCELLED', 'NO_SHOW');
/// `prisma migrate diff`/`db pull` will permanently show this as one line of "drift" — expected,
/// not a bug. Do not "fix" it by adding a conflicting @@unique here.
model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  clinicId        String
  scheduledAt     DateTime
  status          AppointmentStatus @default(CONFIRMED)
  tokenNumber     String?
  reasonForVisit  String?
  consultationFee Decimal?          @db.Decimal(10, 2)
  /// Walk-in intake flag only, set by reception at registration — no payment processing.
  paymentStatus   PaymentStatus?
  cancelReason    String?
  cancelledAt     DateTime?
  completedAt     DateTime?

  /// Human-friendly, publicly-safe reference (e.g. "APT-20260815-8F4K2") — never the row id.
  bookingReference   String           @unique
  /// Always server-derived from the authenticated actor's role — never accepted from the client.
  bookingSource      BookingSource    @default(PATIENT)
  appointmentType    AppointmentType  @default(NEW_CONSULTATION)
  /// Modality only (IN_CLINIC/ONLINE) — booking input validation rejects FOLLOW_UP/EMERGENCY here.
  consultationType   ConsultationType @default(IN_CLINIC)
  /// Snapshotted at booking/reschedule time — later ClinicSettings/ClinicDoctor config changes
  /// must never retroactively change historical appointments.
  durationMinutes    Int?
  bufferMinutesAfter Int?

  // --- Reschedule metadata (same row, updated in place — no separate linked row) ---
  previousScheduledAt DateTime?
  rescheduledAt       DateTime?
  rescheduledByUserId String?
  rescheduleReason    String?
  rescheduleCount     Int       @default(0)

  // --- Cancellation metadata (extends cancelReason/cancelledAt above) ---
  cancelledByUserId          String?
  cancelSource               BookingSource?
  previousStatusBeforeCancel AppointmentStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient                Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor                 Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic                 Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptions          Prescription[]
  labReports             LabReport[]
  queueToken             QueueToken?
  consultation           Consultation?
  payment                Payment?
  invoice                Invoice?
  doctorReview           DoctorReview?
  clinicReview           ClinicReview?
  /// Reverse of WaitlistEntry.fulfilledAppointmentId — at most one waitlist entry can point back
  /// to a given appointment (enforced by that field's own @unique), so this is optional, not a list.
  fulfilledWaitlistEntry WaitlistEntry?

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([clinicId, scheduledAt])
  @@index([status])
  @@map("appointments")
}

/// One row per (doctorId, clinicId, scheduledAt) tuple, recycled across its lifecycle (never
/// deleted — status flips ACTIVE→RELEASED/EXPIRED and back to ACTIVE on reclaim). Because there
/// is only ever one row per slot at a time, a plain (non-partial) unique constraint is enough
/// here — unlike Appointment, which needs the hand-added partial index described above.
/// `status = 'ACTIVE'` is necessary but NOT sufficient to treat a row as holding a slot — every
/// reader must also check `expiresAt > now()`; there is no background sweep (no job/cron
/// infrastructure exists anywhere in this codebase), so expiry is resolved lazily, only when a
/// later claim attempt reclaims the stale row.
model SlotHold {
  id               String           @id @default(uuid())
  doctorId         String
  clinicId         String
  scheduledAt      DateTime
  durationMinutes  Int
  patientId        String
  heldByUserId     String
  bookingSource    BookingSource
  consultationType ConsultationType
  status           SlotHoldStatus   @default(ACTIVE)
  expiresAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId, scheduledAt])
  @@index([expiresAt, status])
  @@index([patientId])
  @@map("slot_holds")
}

/// Arbitrary time-range block set by a doctor or authorized clinic staff — not slot-grid-aligned.
/// `doctorId = null` means a clinic-wide block. No uniqueness constraint: overlapping blocks are
/// harmless (their union is what matters for availability filtering).
model BlockedSlot {
  id                String    @id @default(uuid())
  doctorId          String?
  clinicId          String
  startAt           DateTime
  endAt             DateTime
  reason            String
  createdByUserId   String
  isActive          Boolean   @default(true)
  unblockedAt       DateTime?
  unblockedByUserId String?

  createdAt DateTime @default(now())

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, startAt])
  @@index([doctorId, startAt])
  @@map("blocked_slots")
}

// ---------------------------------------------------------------------------
// Appointment Waitlist (Phase 13)
// ---------------------------------------------------------------------------

/// EXPIRED is deliberately absent — like SlotHold, it is never a stored value. A row whose
/// `targetDate` has passed while still ACTIVE/NOTIFIED is presented as "expired" only at read
/// time (no cron/job infra exists anywhere in this codebase, so nothing sweeps stale rows).
enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  FULFILLED
  CANCELLED
}

/// A patient's standing request to be told when a slot opens up for a specific doctor+clinic+date
/// that currently has none suiting them. Deliberately date-level, not time-slot-level — matching
/// "waitlist for a day", not "waitlist for exactly 10:30am". Never auto-books: when a matching
/// slot frees up (appointment cancelled/no-showed/rescheduled away), every ACTIVE/NOTIFIED entry
/// for that doctor+clinic+date is notified and must complete the booking themselves through the
/// existing booking engine — whose partial unique index on `appointments` (see above) is what
/// already guarantees at most one of several racing/notified patients can actually claim the slot,
/// so this model needs no claim/hold mechanism of its own.
model WaitlistEntry {
  id               String            @id @default(uuid())
  patientId        String
  doctorId         String
  clinicId         String
  targetDate       DateTime          @db.Date
  consultationType ConsultationType?
  notes            String?
  status           WaitlistStatus    @default(ACTIVE)

  notifiedAt        DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  /// The user who created this entry — the patient themselves, or a reception/clinic-staff user
  /// adding it on their behalf. Distinct from `patientId` (who the entry is for).
  createdByUserId   String

  /// Set once a booking is made for this doctor+clinic+targetDate by the same patient, via the
  /// normal booking engine (`book()`/`reschedule()`) — not written by any waitlist-specific code
  /// path. `@unique` because one waitlist entry can only ever be satisfied by one appointment.
  fulfilledAppointmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient              Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor               Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic               Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  fulfilledAppointment Appointment? @relation(fields: [fulfilledAppointmentId], references: [id], onDelete: SetNull)

  /// The real, DB-enforced "one active/notified waitlist entry per patient+doctor+clinic+date"
  /// guarantee is a hand-added partial unique index (see migration.sql) — Postgres partial unique
  /// indexes aren't expressible in the Prisma schema DSL, exactly like the Appointment double-
  /// booking guard above. `prisma migrate diff`/`db pull` will show this as permanent one-line
  /// drift — expected, not a bug.
  @@index([doctorId, clinicId, targetDate, status])
  @@index([patientId, status])
  @@index([clinicId, status])
  @@map("waitlist_entries")
}

// ---------------------------------------------------------------------------
// Payments & Billing Engine (Phase 9)
// ---------------------------------------------------------------------------

/// The logical, one-per-appointment payment obligation. `status` is the aggregate/source-of-truth
/// state (see PAYMENT_STATE_MACHINE) — individual provider order/checkout attempts live in
/// `PaymentAttempt` underneath so a failed attempt can be retried without creating a second
/// logical payment or a second appointment. `subtotal`/`discount`/`tax`/`amount` are a server-computed
/// snapshot taken at creation time (see pricing.service.ts) — later ClinicSettings/fee changes must
/// never retroactively change a historical payment, exactly like Appointment's own fee snapshot.
model Payment {
  id            String @id @default(uuid())
  appointmentId String @unique
  patientId     String
  doctorId      String
  clinicId      String

  provider PaymentProvider
  status   PaymentTransactionStatus @default(CREATED)

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  amount   Decimal @db.Decimal(10, 2)
  currency String

  method            PaymentMethod?
  /// Denormalized pointers to the active/latest attempt for fast lookup by provider callbacks —
  /// PaymentAttempt rows underneath remain the durable per-attempt record.
  providerOrderId   String?
  providerPaymentId String?
  capturedAmount    Decimal?       @db.Decimal(10, 2)
  refundedAmount    Decimal        @default(0) @db.Decimal(10, 2)

  /// Payment order expiry — lazily enforced (no cron/job infra in this codebase, matching
  /// SlotHold's own documented lazy-expiry convention). Checked whenever a payment is read
  /// (GET /payments/:id[/status]) or when a new booking collides with a stale PENDING appointment.
  expiresAt   DateTime
  capturedAt  DateTime?
  cancelledAt DateTime?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment   Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic        Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  attempts      PaymentAttempt[]
  webhookEvents PaymentWebhookEvent[]
  invoice       Invoice?
  refunds       Refund[]

  @@index([patientId])
  @@index([clinicId])
  @@index([doctorId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

/// One row per provider order/checkout attempt. A retry after FAILED creates a new attempt
/// (attemptNumber incremented) rather than a new Payment — "one logical payment/appointment
/// relationship" per the Phase 9 spec.
model PaymentAttempt {
  id                String               @id @default(uuid())
  paymentId         String
  attemptNumber     Int
  provider          PaymentProvider
  providerOrderId   String
  providerPaymentId String?
  amount            Decimal              @db.Decimal(10, 2)
  currency          String
  status            PaymentAttemptStatus @default(CREATED)
  method            PaymentMethod?
  /// Safe-for-patients failure text only — never a raw provider error body or stack trace.
  failureCode       String?
  failureMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerOrderId])
  @@index([paymentId])
  @@index([providerPaymentId])
  @@map("payment_attempts")
}

/// Idempotency ledger for provider webhook delivery — the unique constraint on
/// (provider, providerEventId) is what makes "the same webhook received twice" a no-op at the
/// database level, not just an application-level check (defense against a genuine race between
/// two concurrent deliveries of the same event).
model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  paymentId       String?
  payload         Json
  processedAt     DateTime?

  createdAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_webhook_events")
}

/// Generated once a Payment reaches CAPTURED — see invoice-number.util.ts for the concurrency-safe
/// sequence generator behind `invoiceNumber`. Financial fields are copied from Payment at issue
/// time (a second, independent snapshot) so a later Payment mutation (e.g. a subsequent refund)
/// cannot retroactively alter an already-issued invoice's figures.
model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique
  paymentId     String @unique
  appointmentId String @unique
  patientId     String
  doctorId      String
  clinicId      String

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  currency String

  status PaymentTransactionStatus
  method PaymentMethod?

  issuedAt DateTime @default(now())

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([clinicId])
  @@index([appointmentId])
  @@map("invoices")
}

/// Per-year atomic counter backing invoice-number.util.ts's `INV-<year>-<seq>` generator — a
/// single-statement `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` against this table is what
/// makes the sequence safe under concurrency (see the "duplicate invoice numbers under
/// concurrency" test requirement), without needing a Postgres SEQUENCE object per year.
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("invoice_sequences")
}

/// Authorized clinic-side refund request against a captured Payment. `status` is the refund's own
/// lifecycle; a successful/failed refund also drives the parent Payment's status via
/// payment-state-machine.ts (never updated ad hoc).
model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  actorUserId      String
  status           RefundStatus @default(REFUND_PENDING)
  providerRefundId String?
  failureMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model Prescription {
  id                    String             @id @default(uuid())
  patientId             String
  doctorId              String
  appointmentId         String?
  consultationId        String?
  issuedAt              DateTime           @default(now())
  /// @deprecated superseded by the structured `items` relation; kept for legacy rows only.
  medications           Json
  status                PrescriptionStatus @default(DRAFT)
  diagnosis             String?
  advice                String?
  followUpDate          DateTime?
  labTestRecommendation String[]
  notes                 String?
  fileUrl               String?
  signedAt              DateTime?
  signatureImageUrl     String?
  signatureHash         String?
  pdfUrl                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment  Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  consultation Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]

  @@index([patientId, issuedAt])
  @@index([consultationId])
  @@index([status])
  @@map("prescriptions")
}

model LabReport {
  id            String          @id @default(uuid())
  patientId     String
  appointmentId String?
  testName      String
  labName       String?
  status        LabReportStatus @default(PENDING)
  reportDate    DateTime?
  fileUrl       String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId, status])
  @@map("lab_reports")
}

model Vaccination {
  id               String    @id @default(uuid())
  patientId        String
  vaccineName      String
  doseNumber       Int?
  administeredDate DateTime
  nextDueDate      DateTime?
  administeredBy   String?
  notes            String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("vaccinations")
}

model VitalRecord {
  id                     String   @id @default(uuid())
  patientId              String
  recordedAt             DateTime @default(now())
  heightCm               Float?
  weightKg               Float?
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRateBpm           Int?
  temperatureCelsius     Float?
  bloodSugarMgDl         Int?
  notes                  String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, recordedAt])
  @@map("vital_records")
}

model MedicalRecord {
  id            String            @id @default(uuid())
  patientId     String
  /// Nullable: legacy/manually-entered records may only have a free-text doctorName. Records
  /// authored through the Doctor Portal's consultation workflow set both this FK and doctorName.
  doctorId      String?
  recordType    MedicalRecordType
  title         String
  description   String?
  recordDate    DateTime
  doctorName    String?
  attachmentUrl String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId, recordDate])
  @@index([doctorId])
  @@map("medical_records")
}

/// Central in-app notification record — the single sink every module dispatches through (see
/// modules/notifications/notification-dispatch.service.ts). `notificationKey`, when supplied by
/// the caller, is a deterministic idempotency key (e.g. "reminder:<appointmentId>:24h" or
/// "payment:<paymentId>:captured") — its unique constraint is what guarantees a duplicated source
/// event (a retried webhook, a re-processed reminder tick) produces exactly one logical
/// notification, not the application code's own "did I already do this" bookkeeping.
model Notification {
  id                String               @id @default(uuid())
  userId            String
  type              NotificationType
  title             String
  message           String
  isRead            Boolean              @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  actionUrl         String?
  priority          NotificationPriority @default(NORMAL)
  /// Nullable + unique: Postgres unique indexes ignore NULLs, so ad-hoc notifications (no key
  /// supplied) never collide with each other while keyed ones are still deduplicated.
  notificationKey   String?              @unique
  /// Set for inherently time-bound notices (e.g. a delay update) so the UI can stop surfacing
  /// them as "current" once stale — the row itself is never deleted for audit/history purposes.
  expiresAt         DateTime?

  createdAt DateTime @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@index([expiresAt])
  @@map("notifications")
}

/// One row per (recipient, notification-category) — replaces the old single-`channel` design
/// with independent Email/In-app toggles per category, per spec. TRANSACTIONAL/SECURITY-tier
/// notification types (see notification-type-config.ts) never consult this table at all — they
/// always deliver both channels, so there is deliberately no "security" or "transactional" row
/// here to toggle off.
model NotificationPreference {
  id     String @id @default(uuid())
  userId String @unique

  appointmentEmail  Boolean @default(true)
  appointmentInApp  Boolean @default(true)
  paymentEmail      Boolean @default(true)
  paymentInApp      Boolean @default(true)
  queueEmail        Boolean @default(false)
  queueInApp        Boolean @default(true)
  prescriptionEmail Boolean @default(true)
  prescriptionInApp Boolean @default(true)
  announcementEmail Boolean @default(true)
  announcementInApp Boolean @default(true)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Tracks an individual email delivery attempt for a Notification — never the provider's secret
/// credentials, only what's needed to show delivery status and drive bounded retry.
model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  recipientEmail    String
  provider          String
  status            NotificationDeliveryStatus @default(QUEUED)
  providerMessageId String?
  attempts          Int                        @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  failureReason     String?

  createdAt DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@index([providerMessageId])
  @@map("notification_deliveries")
}

/// Receptionists / clinic staff / clinic admins scoped to a specific clinic.
model ClinicStaffMember {
  id          String   @id @default(uuid())
  userId      String
  clinicId    String
  /// No name field exists on User for staff roles (only Doctor/Patient carry a profile name) —
  /// tracked here since it's meaningful per clinic-staff membership, not per platform account.
  fullName    String?
  title       String?
  isActive    Boolean  @default(true)
  /// Canonical keys defined once in packages/shared/src/permissions.ts (e.g. "queue.manage",
  /// "patient.checkin"). CLINIC_ADMIN role bypasses this list entirely — see reception.shared.ts.
  permissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId])
  @@map("clinic_staff_members")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  /// Denormalized for direct "clinic queue history" queries without joining through entityId.
  /// Nullable — most audit rows (auth, profile edits) aren't clinic-scoped.
  clinicId    String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Clinic Management (Phase 6)
// ---------------------------------------------------------------------------

/// A verification/registration document uploaded by a Clinic Admin. Stored outside the public
/// `/uploads` static mount (see storage.service.ts::savePrivateFile) — served only through an
/// authenticated, permission-checked download route, never a public URL.
model ClinicDocument {
  id               String               @id @default(uuid())
  clinicId         String
  type             ClinicDocumentType
  fileName         String
  relativePath     String
  fileSizeBytes    Int
  mimeType         String
  status           ClinicDocumentStatus @default(UPLOADED)
  uploadedByUserId String

  createdAt DateTime @default(now())

  clinic     Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, type])
  @@map("clinic_documents")
}

model Department {
  id           String  @id @default(uuid())
  clinicId     String
  name         String
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicDoctors ClinicDoctor[]
  services      ClinicService[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
  @@map("departments")
}

/// A billable/bookable service offered by the clinic. Price is informational only — no payment
/// engine in this phase.
model ClinicService {
  id              String  @id @default(uuid())
  clinicId        String
  departmentId    String?
  name            String
  description     String?
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)
  taxApplicable   Boolean @default(false)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
  @@index([departmentId])
  @@map("clinic_services")
}

/// One weekday's schedule for a clinic. Multiple sessions (e.g. morning + evening) live on the
/// child `ClinicWorkingHoursSession` rows.
model ClinicWorkingHours {
  id       String  @id @default(uuid())
  clinicId String
  weekday  Weekday
  isOpen   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic   Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sessions ClinicWorkingHoursSession[]

  @@unique([clinicId, weekday])
  @@map("clinic_working_hours")
}

model ClinicWorkingHoursSession {
  id             String   @id @default(uuid())
  workingHoursId String
  startTime      DateTime @db.Time
  endTime        DateTime @db.Time

  workingHours ClinicWorkingHours @relation(fields: [workingHoursId], references: [id], onDelete: Cascade)

  @@index([workingHoursId])
  @@map("clinic_working_hours_sessions")
}

model ClinicHoliday {
  id          String    @id @default(uuid())
  clinicId    String
  date        DateTime  @db.Date
  name        String
  description String?
  isFullDay   Boolean   @default(true)
  startTime   DateTime? @db.Time
  endTime     DateTime? @db.Time

  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, date])
  @@map("clinic_holidays")
}

model ClinicResource {
  id       String               @id @default(uuid())
  clinicId String
  name     String
  type     ClinicResourceType
  code     String?
  floor    String?
  capacity Int?
  status   ClinicResourceStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, type])
  @@index([clinicId, status])
  @@map("clinic_resources")
}

/// An outstanding (or resolved) invite for someone to join a clinic's staff. Accepting either
/// links an existing User (by email) or provisions a new one — never a duplicate account, same
/// principle as walk-in patient linking in Reception.
model StaffInvitation {
  id              String                @id @default(uuid())
  clinicId        String
  email           String
  role            UserRole
  title           String?
  permissions     String[]              @default([])
  token           String                @unique
  status          StaffInvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?

  createdAt DateTime @default(now())

  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedBy User   @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, email])
  @@index([clinicId, status])
  @@map("staff_invitations")
}

/// Clinic-level configuration — the source of truth consumed by the Doctor Portal and Reception
/// modules where noted. One row per clinic, created lazily with defaults on first read.
model ClinicSettings {
  id       String @id @default(uuid())
  clinicId String @unique

  /// General
  currency String @default("INR")

  /// Appointment
  defaultConsultationDurationMinutes Int     @default(15)
  bufferMinutes                      Int     @default(0)
  cancellationPolicy                 String?
  noShowPolicy                       String?

  /// Payments & Billing (Phase 9) — opt-in per clinic, defaults preserve every existing clinic's
  /// current behavior exactly (online payment not required, appointments confirm immediately as
  /// they did before this phase; see booking.engine.ts's `book()`).
  onlinePaymentRequired       Boolean  @default(false)
  taxPercent                  Decimal? @db.Decimal(5, 2)
  serviceFeeFlat              Decimal? @db.Decimal(10, 2)
  /// Refund eligibility percentage (0–100) used by refund-eligibility.service.ts's centralized
  /// rule — kept a simple flat percentage rather than parsing the free-text `cancellationPolicy`
  /// above, which is display copy, not a machine-readable policy.
  refundOnCancellationPercent Int      @default(100)

  /// Queue — consumed by the existing queue engine (modules/queue-engine), which remains the
  /// source of truth for queue *behavior*; these are inputs to it, not a parallel implementation.
  queueEnabled             Boolean @default(true)
  tokenPrefix              String?
  startingTokenNumber      Int     @default(1)
  dailyTokenReset          Boolean @default(true)
  priorityQueueEnabled     Boolean @default(true)
  emergencyPriorityEnabled Boolean @default(true)

  /// Notifications — reuses the existing notification architecture (modules/notifications);
  /// these are on/off switches consumed at the call sites that already emit notifications.
  appointmentNotificationsEnabled Boolean @default(true)
  queueNotificationsEnabled       Boolean @default(true)
  delayNotificationsEnabled       Boolean @default(true)
  reminderMinutesBefore           Int?    @default(60)

  /// Privacy
  patientDataVisibility PatientDataVisibility @default(LIMITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_settings")
}
